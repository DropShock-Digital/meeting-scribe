# Local API configuration
MEETING_SCRIBE_BIND_HOST=127.0.0.1
MEETING_SCRIBE_PORT=8080
MEETING_SCRIBE_DATA_DIR=/data
MEETING_SCRIBE_CHANNEL_ALLOWLIST=demo-room
MEETING_SCRIBE_OPERATOR_ALLOWLIST=local-demo
