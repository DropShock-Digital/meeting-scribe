# Local API configuration
MEETING_SCRIBE_BIND_HOST=127.0.0.1
MEETING_SCRIBE_PORT=8080
MEETING_SCRIBE_DATA_DIR=/data
MEETING_SCRIBE_CHANNEL_ALLOWLIST=demo-room
MEETING_SCRIBE_OPERATOR_ALLOWLIST=local-demo
MEETING_SCRIBE_MAX_TRANSCRIPT_CHARS=4000

# Human-readable voice-room catalog. Room IDs stay server-side and must already
# exist in MEETING_SCRIBE_CHANNEL_ALLOWLIST; the browser receives labels only.
MEETING_SCRIBE_ROOM_CATALOG='[{"key":"local-review","channel_id":"demo-room","label":"Demo room"}]'

# AI-provider configuration. The control room stores only an operator preference;
# it never accepts or displays tokens/keys/endpoints and does not send content yet.
MEETING_SCRIBE_CODEX_OAUTH_CONFIGURED=false
MEETING_SCRIBE_OPENROUTER_API_KEY_FILE=
MEETING_SCRIBE_LMSTUDIO_CONFIGURED=false
MEETING_SCRIBE_COMPATIBLE_PROVIDER_LABEL=OpenAI-compatible
MEETING_SCRIBE_COMPATIBLE_PROVIDER_CONFIGURED=false

# Optional Discord adapter. Leave disabled for the local demo.
MEETING_SCRIBE_DISCORD_ENABLED=false
MEETING_SCRIBE_DISCORD_TOKEN=
MEETING_SCRIBE_DISCORD_GUILD_ID=
